+@app.post("/api/mcp/servers")
+async def mcp_servers_post(body: McpUpsertBody, _auth: None = Depends(require_auth)):
+    if body.type not in ("http", "sse"):
+        raise HTTPException(status_code=400, detail="type 只能是 http 或 sse")
+    if not str(body.url).startswith(("http://", "https://")):
+        raise HTTPException(status_code=400, detail="URL 要以 http(s):// 开头")
+    if not body.name.strip():
+        raise HTTPException(status_code=400, detail="名称不能为空")
+    servers = await mcp_load_servers()
+    if body.id:
+        s = next((x for x in servers if x.get("id") == body.id), None)
+        if s is None:
+            raise HTTPException(status_code=404, detail="服务器不存在")
+    else:
+        s = {"id": uuid.uuid4().hex, "connected": False, "error": "", "checkedAt": None, "tools": []}
+        servers.append(s)
+    s["name"] = body.name.strip()
+    s["url"] = body.url.strip()
+    s["type"] = body.type
+    s["enabled"] = bool(body.enabled)
+    if body.bearer is not None:
+        s["bearer"] = body.bearer
+        s.pop("connected", None)        # 鉴权变了，旧状态不可信
+    if body.headers is not None:
+        s["headers"] = body.headers
+        s.pop("connected", None)
+    s["connected"] = False
+    s["error"] = ""
+    await mcp_save_servers(servers)
+    return {"server": mcp_public(s)}
