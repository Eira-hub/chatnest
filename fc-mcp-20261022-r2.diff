+# ────────────────────────────── MCP（服务器管理 + 工具调用） ──────────────────────────────
+
+MCP_KEY = "idx:mcp"
+MCP_PROTOCOL_VERSION = "2025-03-26"
+MCP_CONNECT_TIMEOUT = env_int("MCP_CONNECT_TIMEOUT", 15)
+MCP_CALL_TIMEOUT = env_int("MCP_CALL_TIMEOUT", 120)
+MCP_MAX_ROUNDS = env_int("MCP_MAX_ROUNDS", 8)          # 单条消息最多几轮工具调用
+MCP_RESULT_MAX_CHARS = env_int("MCP_RESULT_MAX_CHARS", 8000)
+
+class McpError(RuntimeError):
+    pass
+
+async def mcp_load_servers() -> List[Dict[str, Any]]:
+    return await kv_get_json(MCP_KEY, [])
+
+async def mcp_save_servers(items: List[Dict[str, Any]]) -> None:
+    await kv_put_json(MCP_KEY, items)
+
+def mcp_public(s: Dict[str, Any]) -> Dict[str, Any]:
+    """前端可见字段；bearer/headers 属敏感信息不回传（前端「留空 = 不修改」契约）。"""
+    tools = s.get("tools") or []
+    return {"id": s.get("id"), "name": s.get("name"), "url": s.get("url"),
+            "type": s.get("type") or "http", "enabled": s.get("enabled", True),
+            "connected": s.get("connected", False), "checkedAt": s.get("checkedAt"),
+            "error": s.get("error") or "",
+            "tools": [{"name": t.get("name"), "description": t.get("description") or "",
+                       "enabled": t.get("enabled", True)} for t in tools],
+            "toolCount": sum(1 for t in tools if t.get("enabled", True)),
+            "totalTools": len(tools)}
+
+def mcp_sanitize_name(s: str, fallback: str = "") -> str:
+    """工具名要过 upstream 的 ^[A-Za-z0-9_-]+$ 校验；中文名会被替换成下划线，
+    一个 ASCII 字符都不剩时回退 srv_<id前缀>，保证全名跨请求稳定。"""
+    out = re.sub(r"[^0-9A-Za-z_-]", "_", str(s or ""))
+    out = re.sub(r"_+", "_", out).strip("_")[:48]
+    if not out:
+        out = "srv_" + re.sub(r"[^0-9a-z]", "", str(fallback or "").lower())[:6]
+    return out or "srv"
+
+async def mcp_openai_tools() -> Tuple[List[Dict[str, Any]], Dict[str, Tuple[Dict[str, Any], str]]]:
+    """所有已启用服务器的已启用工具 → OpenAI tools 定义 + 全名→(服务器, 原始工具名) 映射。"""
+    tools: List[Dict[str, Any]] = []
+    index: Dict[str, Tuple[Dict[str, Any], str]] = {}
+    for s in await mcp_load_servers():
+        if not s.get("enabled", True):
+            continue
+        sn = mcp_sanitize_name(s.get("name"), s.get("id", ""))
+        for t in s.get("tools") or []:
+            if not t.get("enabled", True) or not t.get("name"):
+                continue
+            full = f"mcp__{sn}__{mcp_sanitize_name(t['name'])}"
+            if full in index:
+                continue
+            index[full] = (s, str(t["name"]))
+            tools.append({"type": "function", "function": {
+                "name": full, "description": t.get("description") or "",
+                "parameters": t.get("inputSchema") or {"type": "object", "properties": {}}}})
+    return tools, index
+
+def mcp_base_headers(srv: Dict[str, Any]) -> Dict[str, str]:
+    h = {"Accept": "application/json, text/event-stream"}
+    if srv.get("bearer"):
+        h["Authorization"] = "Bearer " + str(srv["bearer"])
+    for k, v in (srv.get("headers") or {}).items():
+        if str(k).lower() in {"content-length", "host", "authorization"}:
+            continue
+        h[str(k)] = str(v)
+    return h
+
+def mcp_parse_sse_objects(text: str) -> List[Dict[str, Any]]:
+    """SSE body 里的 data: 行逐条解析成 JSON-RPC 对象。"""
+    out: List[Dict[str, Any]] = []
+    for line in str(text or "").splitlines():
+        line = line.strip()
+        if line.startswith("data:"):
+            d = line[5:].strip()
+            if d and d != "[DONE]":
+                try:
+                    o = json.loads(d)
+                except ValueError:
+                    continue
+                if isinstance(o, dict):
+                    out.append(o)
+    return out
+
+def mcp_check_rpc(obj: Dict[str, Any]) -> Any:
+    if obj.get("error"):
+        err = obj["error"]
+        msg = err.get("message") if isinstance(err, dict) else str(err)
+        raise McpError(str(msg or "MCP 调用失败"))
+    return obj.get("result")
+
+def mcp_content_text(res: Dict[str, Any]) -> str:
+    parts: List[str] = []
+    for c in res.get("content") or []:
+        if not isinstance(c, dict):
+            continue
+        if c.get("type") == "text" and c.get("text"):
+            parts.append(str(c["text"]))
+        elif c.get("uri") or (c.get("type") == "resource" and c.get("text")):
+            parts.append(str(c.get("text") or c.get("uri")))
+    if not parts and res.get("structuredContent") is not None:
+        try:
+            parts.append(json.dumps(res["structuredContent"], ensure_ascii=False))
+        except (TypeError, ValueError):
+            pass
+    text = "\n".join(parts).strip()
+    if len(text) > MCP_RESULT_MAX_CHARS:
+        text = text[:MCP_RESULT_MAX_CHARS] + "…（已截断）"
+    return text
+
+class McpClient:
+    """最小 MCP 客户端：streamable HTTP（type=http）与 HTTP+SSE（type=sse）两种传输，
+    只实现 initialize / tools/list / tools/call，够管理页和工具循环用。"""
+
+    def __init__(self, srv: Dict[str, Any]):
+        self.srv = srv
+        self.ttype = "sse" if srv.get("type") == "sse" else "http"
+        self.session_id: Optional[str] = None
+        self._client: Optional[httpx.AsyncClient] = None
+        self._resp: Optional[httpx.Response] = None    # sse 传输的常驻 GET 流
+        self._lines: Optional[AsyncIterator[str]] = None
+        self.endpoint: Optional[str] = None
+        self._nid = 0
+
+    async def __aenter__(self) -> "McpClient":
+        self._client = httpx.AsyncClient(timeout=httpx.Timeout(
+            connect=MCP_CONNECT_TIMEOUT, read=MCP_CALL_TIMEOUT, write=30, pool=MCP_CONNECT_TIMEOUT))
+        try:
+            await self._connect()
+        except BaseException:
+            await self._client.aclose()
+            raise
+        return self
+
+    async def __aexit__(self, *exc) -> None:
+        try:
+            if self._resp is not None:
+                await self._resp.aclose()
+        finally:
+            await self._client.aclose()
+
+    async def _connect(self) -> None:
+        if self.ttype == "sse":
+            await self._sse_open_stream()
+        await self._rpc("initialize", {"protocolVersion": MCP_PROTOCOL_VERSION, "capabilities": {},
+                                       "clientInfo": {"name": "chatnest", "version": "1.0.0"}})
+        await self._rpc("notifications/initialized", notify=True)
+
+    def _next_id(self) -> int:
+        self._nid += 1
+        return self._nid
+
+    async def _rpc(self, method: str, params: Optional[Dict[str, Any]] = None,
+                   notify: bool = False) -> Any:
+        payload: Dict[str, Any] = {"jsonrpc": "2.0", "method": method}
+        if params is not None:
+            payload["params"] = params
+        rid = None
+        if not notify:
+            rid = self._next_id()
+            payload["id"] = rid
+        if self.ttype == "http":
+            return await self._http_rpc(payload, rid)
+        return await self._sse_rpc(payload, rid)
+
+    async def _http_rpc(self, payload: Dict[str, Any], rid: Optional[int]) -> Any:
+        """streamable HTTP：POST 一次拿一个响应（application/json 或 sse 包裹）。"""
+        headers = mcp_base_headers(self.srv)
+        if self.session_id:
+            headers["Mcp-Session-Id"] = self.session_id
+        r = await self._client.post(self.srv["url"], json=payload, headers=headers)
+        sid = r.headers.get("mcp-session-id")
+        if sid:
+            self.session_id = sid
+        if r.status_code in (202, 204):
+            return None
+        if r.status_code != 200:
+            raise McpError(f"HTTP {r.status_code}：{r.text[:200]}")
+        if "text/event-stream" in r.headers.get("content-type", ""):
+            objs = mcp_parse_sse_objects(r.text)
+        else:
+            try:
+                objs = [r.json()]
+            except ValueError:
+                raise McpError(f"响应不是 JSON：{r.text[:200]}")
+        for o in objs:
+            if rid is None or o.get("id") == rid:
+                return mcp_check_rpc(o)
+        return None
+
+    async def _sse_open_stream(self) -> None:
+        """旧式 HTTP+SSE：先 GET 常驻事件流，等 endpoint 事件拿 POST 地址。"""
+        headers = mcp_base_headers(self.srv)
+        headers["Accept"] = "text/event-stream"
+        req = self._client.build_request("GET", self.srv["url"], headers=headers)
+        self._resp = await self._client.send(req, stream=True)
+        if self._resp.status_code != 200:
+            status = self._resp.status_code
+            body = (await self._resp.aread())[:300].decode("utf-8", errors="replace")
+            await self._resp.aclose()
+            self._resp = None
+            raise McpError(f"SSE {status}：{body}")
+        self._lines = self._resp.aiter_lines()
+        ev = None
+        async for line in self._lines:
+            line = line.strip()
+            if line.startswith("event:"):
+                ev = line[6:].strip()
+            elif line.startswith("data:") and (ev == "endpoint" or ev is None):
+                d = line[5:].strip()
+                if d:
+                    self.endpoint = urljoin(self.srv["url"], d)
+                    return
+                ev = None
+        raise McpError("SSE 流里没等到 endpoint 事件")
+
+    async def _sse_rpc(self, payload: Dict[str, Any], rid: Optional[int]) -> Any:
+        headers = mcp_base_headers(self.srv)
+        headers["Content-Type"] = "application/json"
+        r = await self._client.post(self.endpoint, json=payload, headers=headers)
+        if r.status_code not in (200, 202, 204):
+            raise McpError(f"POST {r.status_code}：{r.text[:200]}")
+        if rid is None:
+            return None
+        # 少数服务器直接把 JSON-RPC 响应放在 POST 回包里
+        if r.status_code == 200 and r.text.strip():
+            try:
+                o = r.json()
+            except ValueError:
+                o = None
+            if isinstance(o, dict) and (o.get("id") == rid or o.get("result") is not None or o.get("error")):
+                return mcp_check_rpc(o)
+        async for line in self._lines:
+            line = line.strip()
+            if not line.startswith("data:"):
+                continue
+            d = line[5:].strip()
+            if not d or d == "[DONE]":
+                continue
+            try:
+                o = json.loads(d)
+            except ValueError:
+                continue
+            if isinstance(o, dict) and o.get("id") == rid:
+                return mcp_check_rpc(o)
+        raise McpError("SSE 流在收到响应前结束")
+
+    async def list_tools(self) -> List[Dict[str, Any]]:
+        res = await self._rpc("tools/list", {})
+        return (res or {}).get("tools") or []
+
+    async def call_tool(self, name: str, arguments: Dict[str, Any]) -> Tuple[bool, str]:
+        res = await self._rpc("tools/call", {"name": name, "arguments": arguments or {}})
+        if not isinstance(res, dict):
+            return True, ""
+        text = mcp_content_text(res)
+        if res.get("isError"):
+            return False, text or "工具返回错误"
+        return True, text
+
+async def mcp_check_server(s: Dict[str, Any]) -> Dict[str, Any]:
+    """连接服务器拉工具清单，更新 connected/tools（保留每个工具的启停配置）。"""
+    old = {t.get("name"): t.get("enabled", True) for t in s.get("tools") or []}
+    try:
+        async with McpClient(s) as cli:
+            tools = await cli.list_tools()
+        s["tools"] = [{"name": str(t.get("name") or ""),
+                       "description": str(t.get("description") or ""),
+                       "inputSchema": t.get("inputSchema") or {"type": "object", "properties": {}},
+                       "enabled": old.get(str(t.get("name") or ""), True)}
+                      for t in tools if t.get("name")]
+        s["connected"] = True
+        s["error"] = ""
+    except Exception as e:
+        s["connected"] = False
+        s["error"] = str(e)[:300]
+    s["checkedAt"] = iso_now()
+    return s
+
+async def mcp_execute(full_name: str, raw_args: str,
+                      index: Dict[str, Tuple[Dict[str, Any], str]]) -> Tuple[bool, str]:
+    """按 mcp__srv__tool 全名找到服务器，连上执行一次 tools/call。"""
+    entry = index.get(full_name)
+    if entry is None:
+        return False, f"未找到工具：{full_name}"
+    srv, raw_name = entry
+    try:
+        args = json.loads(raw_args) if (raw_args or "").strip() else {}
+    except ValueError:
+        return False, "工具参数不是合法 JSON"
+    if not isinstance(args, dict):
+        return False, "工具参数必须是 JSON 对象"
+    try:
+        async with McpClient(srv) as cli:
+            return await cli.call_tool(raw_name, args)
+    except Exception as e:
+        return False, f"工具调用失败：{e}"
+
+
